    {
        "id": "fn1",
        "type": "function",
        "z": "f1",
        "name": "Procesar",
        "func": "const p=msg.payload;\nif(!p||p.Cliente_Activo===undefined)return null;\nflow.set('lastRx',Date.now());\nflow.set('clienteActivo',Number(p.Cliente_Activo));\nconst MOT={0:'—',1:'Expiración',2:'Liberación',3:'Desconexión',4:'Deshabilitado',5:'Manual'};\nconst mmss=s=>{s=Math.max(0,s|0);return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');};\nconst a=p.Cliente_Activo;\nconst ok=(a>=1&&a<=4);\nconst asig=ok?p['C'+a+'_Asignado']:0;\nconst rest=ok?p.Tiempo_Restante:0;\nconst n=Math.min(Math.max(p.Cola_Longitud,0),4);\nconst cola=[p.Cola1,p.Cola2,p.Cola3,p.Cola4].slice(0,n).map(c=>'C'+c);\nconst cl=[1,2,3,4].map(i=>{const con=p['C'+i+'_Conectado'],q=p['C'+i+'_EnCola'];return {id:'C'+i,con:con,enCola:q,pos:p['C'+i+'_Pos'],turnos:p['C'+i+'_Turnos'],est:!con?'D':(a===i?'A':(q?'Q':'L'))};});\nmsg.payload={activoTxt:ok?'C'+a:'Línea libre',asigTxt:mmss(asig),restTxt:mmss(rest),pct:asig>0?Math.min(100,Math.max(0,rest*100/asig)):0,cola:cola,clientes:cl,motivo:MOT[p.Motivo_Ultimo_Fin]||'?',anterior:p.Cliente_Anterior>0?'C'+p.Cliente_Anterior:'—',total:p.Total_Asignaciones,modo:p.Modo_Manual,forzado:p.Cliente_Forzado,tconfig:p.Tiempo_Turno_Config};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [
            [
                "t1",
                "t2"
            ]
        ]
    },

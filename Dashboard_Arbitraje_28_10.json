    {
        "id": "t1",
        "type": "ui-template",
        "z": "f1",
        "group": "g1",
        "page": "",
        "ui": "",
        "name": "Tablero",
        "order": 1,
        "width": "0",
        "height": "0",
        "head": "",
        "format": "<template>\n<div v-if=\"!msg || !msg.payload\">Esperando datos</div>\n<div v-else-if=\"msg.payload.sinDatos\" style=\"background:#fdecea;border:2px solid #d32f2f;color:#b71c1c;border-radius:12px;padding:20px;font-size:20px;font-weight:bold;text-align:center\">SIN DATOS: enlace con el PLC Central perdido</div>\n<div v-else>\n<div style=\"font-size:12px;color:#2e7d32;margin-bottom:8px\">● Enlace con el PLC Central: activo</div>\n<div :style=\"{background: msg.payload.activoTxt === 'Línea libre' ? '#eceff1' : '#e8f5e9', border: '2px solid ' + (msg.payload.activoTxt === 'Línea libre' ? '#90a4ae' : '#2e7d32'), borderRadius: '12px', padding: '20px'}\">\n<div style=\"font-size:13px;letter-spacing:1px;color:#546e7a\">PLC CON CONTROL ACTIVO</div>\n<div :style=\"{fontSize:'48px', fontWeight:'bold', color: msg.payload.activoTxt === 'Línea libre' ? '#455a64' : '#1b5e20'}\">{{ msg.payload.activoTxt }}</div>\n<div style=\"font-size:13px;letter-spacing:1px;color:#546e7a;margin-top:8px\">TIEMPO RESTANTE</div>\n<div style=\"font-size:40px;font-weight:bold;color:#263238\">{{ msg.payload.restTxt }}</div>\n<div style=\"font-size:14px;color:#546e7a;margin-bottom:8px\">Tiempo asignado: {{ msg.payload.asigTxt }}</div>\n<div style=\"background:#cfd8dc;border-radius:8px;height:22px;overflow:hidden\">\n<div :style=\"{width: msg.payload.pct + '%', height: '100%', transition: 'width 0.4s', background: msg.payload.pct > 50 ? '#2e7d32' : (msg.payload.pct > 20 ? '#f9a825' : '#c62828')}\"></div>\n</div>\n</div>\n<div style=\"margin-top:16px\">\n<div style=\"font-size:13px;letter-spacing:1px;color:#546e7a;margin-bottom:6px\">COLA DE ESPERA</div>\n<div v-if=\"msg.payload.cola.length\" style=\"display:flex;flex-wrap:wrap;gap:8px\">\n<div v-for=\"(q, i) in msg.payload.cola\" :key=\"i\" style=\"background:#fff8e1;border:2px solid #f9a825;border-radius:20px;padding:6px 16px;font-weight:bold;color:#e65100\">{{ i + 1 }} · {{ q }}</div>\n</div>\n<div v-else style=\"color:#78909c\">Sin solicitudes en espera</div>\n</div>\n<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:16px\">\n<div v-for=\"c in msg.payload.clientes\" :key=\"c.id\" :style=\"{background: {D:'#ffebee',A:'#e8f5e9',Q:'#fff8e1',L:'#e3f2fd'}[c.est], border: '2px solid ' + {D:'#c62828',A:'#2e7d32',Q:'#f9a825',L:'#1565c0'}[c.est], borderRadius:'12px', padding:'14px'}\">\n<div style=\"font-size:26px;font-weight:bold;color:#263238\">{{ c.id }}</div>\n<div :style=\"{fontSize:'13px', fontWeight:'bold', letterSpacing:'1px', color: {D:'#b71c1c',A:'#1b5e20',Q:'#e65100',L:'#0d47a1'}[c.est]}\">{{ c.est === 'D' ? 'DESCONECTADO' : (c.est === 'A' ? 'ACTIVO' : (c.est === 'Q' ? 'EN COLA #' + c.pos : 'LIBRE')) }}</div>\n<div style=\"font-size:13px;color:#546e7a;margin-top:6px\">Turnos: {{ c.turnos }}</div>\n</div>\n</div>\n<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:16px\">\n<div style=\"background:#f5f5f5;border-radius:10px;padding:12px\"><div style=\"font-size:12px;color:#546e7a\">ÚLTIMO FIN</div><div style=\"font-size:18px;font-weight:bold;color:#263238\">{{ msg.payload.motivo }}</div></div>\n<div style=\"background:#f5f5f5;border-radius:10px;padding:12px\"><div style=\"font-size:12px;color:#546e7a\">PLC ANTERIOR</div><div style=\"font-size:18px;font-weight:bold;color:#263238\">{{ msg.payload.anterior }}</div></div>\n<div style=\"background:#f5f5f5;border-radius:10px;padding:12px\"><div style=\"font-size:12px;color:#546e7a\">ASIGNACIONES</div><div style=\"font-size:18px;font-weight:bold;color:#263238\">{{ msg.payload.total }}</div></div>\n</div>\n</div>\n</template>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",

    {
        "id": "t2",
        "type": "ui-template",
        "z": "f1",
        "group": "g2",
        "page": "",
        "ui": "",
        "name": "Panel manual",
        "order": 1,
        "width": "0",
        "height": "0",
        "head": "",
        "format": "<template>\n<div v-if=\"!msg || !msg.payload\">Esperando datos</div>\n<div v-else-if=\"msg.payload.sinDatos\" style=\"background:#fdecea;border:2px solid #d32f2f;color:#b71c1c;border-radius:12px;padding:20px;font-weight:bold\">SIN DATOS: enlace con el PLC Central perdido</div>\n<div v-else>\n<div style=\"background:#fff3e0;border:2px solid #ef6c00;border-radius:12px;padding:12px;color:#e65100;font-weight:bold\">Panel sin protección de acceso.</div>\n<div style=\"margin-top:12px\">Modo manual: <b>{{ msg.payload.modo === undefined ? '—' : (msg.payload.modo ? 'ACTIVO' : 'Inactivo') }}</b></div>\n<div>PLC forzado: <b>{{ msg.payload.forzado === undefined ? '—' : msg.payload.forzado }}</b></div>\n<div>Tiempo de turno configurado: <b>{{ msg.payload.tconfig === undefined ? '—' : msg.payload.tconfig + ' s' }}</b></div>\n<hr style=\"margin:14px 0\">\n<label style=\"font-weight:bold\"><input type=\"checkbox\" v-model=\"hab\"> Habilitar escritura</label>\n<div style=\"margin-top:12px\">PLC a asignar:\n<select v-model.number=\"sel\" style=\"border:1px solid #90a4ae;border-radius:6px;padding:4px 8px\"><option :value=\"1\">C1</option><option :value=\"2\">C2</option><option :value=\"3\">C3</option><option :value=\"4\">C4</option></select>\n<button :disabled=\"!hab\" @click=\"asignar()\" style=\"margin-left:8px;padding:6px 14px;border-radius:6px;background:#1565c0;color:#fff;border:none\">Asignar turno</button>\n<button :disabled=\"!hab\" @click=\"desactivar()\" style=\"margin-left:8px;padding:6px 14px;border-radius:6px;background:#546e7a;color:#fff;border:none\">Volver a automático</button>\n<button :disabled=\"!hab\" @click=\"liberar()\" style=\"margin-left:8px;padding:6px 14px;border-radius:6px;background:#c62828;color:#fff;border:none\">Liberar turno</button></div>\n<div style=\"margin-top:12px\">Tiempo de turno (60 a 5400 s):\n<input type=\"number\" v-model.number=\"t\" min=\"60\" max=\"5400\" style=\"width:90px;border:1px solid #90a4ae;border-radius:6px;padding:4px 8px\">\n<button :disabled=\"!hab\" @click=\"fijarTiempo()\" style=\"margin-left:8px;padding:6px 14px;border-radius:6px;background:#1565c0;color:#fff;border:none\">Aplicar tiempo</button>\n</div>\n<div style=\"margin-top:10px;color:#37474f\">{{ info }}</div>\n</div>\n</template>\n<script>\nexport default {\n  data() { return { hab: false, sel: 1, t: 1800, info: '' } },\n  methods: {\n    liberar() {\n      if (!confirm('¿Quitar el turno al cliente activo?')) return;\n      this.send({ topic: 'liberar', payload: true });\n      this.info = 'Enviado: liberar turno';\n    },\n    asignar() {\n      if (!confirm('¿Asignar el control a C' + this.sel + '?')) return;\n      this.send({ topic: 'forzado', payload: this.sel });\n      this.send({ topic: 'manual', payload: true });\n      this.info = 'Enviado: asignar C' + this.sel;\n    },\n    desactivar() {\n      if (!confirm('¿Volver al modo automático?')) return;\n      this.send({ topic: 'manual', payload: false });\n      this.send({ topic: 'forzado', payload: 0 });\n      this.info = 'Enviado: modo automático';\n    },\n    fijarTiempo() {\n      if (!(this.t >= 60 && this.t <= 5400)) { this.info = 'Valor fuera de rango (60 a 5400 s)'; return; }\n      if (!confirm('¿Fijar el tiempo de turno en ' + this.t + ' s? Aplica a los turnos nuevos.')) return;\n      this.send({ topic: 'tiempo', payload: this.t });\n      this.info = 'Enviado: ' + this.t + ' s';\n    }\n  }\n}\n</script>",

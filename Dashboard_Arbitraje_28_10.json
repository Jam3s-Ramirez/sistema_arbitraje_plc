    {
        "id": "fl1",
        "type": "function",
        "z": "f1",
        "name": "Filtro de escritura",
        "func": "const t = msg.topic, v = msg.payload;\nconst log = (ok, txt) => ({ payload: { fecha: new Date().toISOString(), topic: t, valor: v, resultado: ok ? 'ACEPTADO' : 'RECHAZADO', detalle: txt } });\nif (t === 'manual' && typeof v === 'boolean') return [{ payload: v }, null, null, log(true, 'Modo_Manual')];\nif (t === 'forzado' && Number.isInteger(v) && v >= 0 && v <= 4) return [null, { payload: v }, null, log(true, 'Cliente_Forzado')];\nif (t === 'tiempo' && Number.isInteger(v) && v >= 60 && v <= 5400) return [null, null, { payload: v }, log(true, 'Tiempo_Turno_Config')];\nif (t === 'liberar' && v === true) {\n    const a = flow.get('clienteActivo');\n    if (Number.isInteger(a) && a >= 1 && a <= 4) {\n        const out = [null, null, null, log(true, 'Liberacion_Pendiente C' + a), null, null, null, null];\n        out[3 + a] = { payload: true };\n        return out;\n    }\n    return [null, null, null, log(false, 'sin cliente activo')];\n}\nreturn [null, null, null, log(false, 'fuera de lista o de rango')];",
